@using Lms.Mvc.Models.ViewModels
@model BookCopyViewModel

<div class="container py-4">

    <!-- Create / Update Card -->
    <div class="card shadow-sm border-0 mb-4">

        <!-- Header -->
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                @(Model.BookCopy.CopyId > 0 ? "Update" : "Create") Book Copy
            </h3>
        </div>

        <!-- Form Body -->
        <div class="card-body">

            <form asp-controller="BookCopy1"
                  asp-action="Save"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Hidden Fields -->
                <input asp-for="BookCopy.BookId" type="hidden" />
                <input asp-for="BookCopy.CopyId" type="hidden" />
                <input asp-for="BookCopy.Status" type="hidden" />

                <!-- Copy Code -->
                <div class="mb-3">
                    <label asp-for="BookCopy.CopyCode" class="form-label">
                        Copy Code
                    </label>

                    @* @Html.EditorFor(x=>x.BookCopy) *@

                    <input asp-for="BookCopy.CopyCode"
                           class="form-control"
                           placeholder="Enter copy code" />

                    <span asp-validation-for="BookCopy.CopyCode"
                          class="text-danger">
                    </span>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Book"
                       asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Back
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>

                        @(Model.BookCopy.CopyId > 0 ? "Update" : "Create")
                    </button>

                </div>

            </form>

        </div>
    </div>


    <!-- Book Copy List -->
    <div class="card shadow-sm border-0">

        <!-- List Header -->
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                Book Copy List
            </h4>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-bordered mb-0 align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Copy Code</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.BookCopies != null && Model.BookCopies.Any())
                        {
                            foreach (var copy in Model.BookCopies)
                            {
                                <tr>

                                    <!-- Copy Code -->
                                    <td>
                                        <strong>@copy.CopyCode</strong>
                                    </td>

                                    <!-- Book Title -->
                                    <td>
                                        @copy.Title
                                    </td>

                                    <!-- Status -->
                                    <td>
                                        @if (copy.Status == 1)
                                        {
                                            <span class="badge bg-success">
                                                Available
                                            </span>
                                        }
                                        else if (copy.Status == 2)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Borrowed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Unknown
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">

                                        <!-- Edit -->
                                        <a asp-controller="BookCopy1"
                                           asp-action="Index"

                                           asp-route-bookId="@copy.BookId"
                                           asp-route-copyId="@copy.CopyId"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-pencil-square"></i>
                                            Edit
                                        </a>

                                        <!-- Delete -->
                                        <form asp-controller="BookCopy1"
                                              asp-action="Delete"
                                              asp-route-copyId="@copy.CopyId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Are you sure you want to delete this book copy?');">

                                                <i class="bi bi-trash"></i>
                                                Delete

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-4">

                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>

                                    No book copies found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>
   

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
