@model IEnumerable<BorrowBookSearchResultModel>

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold">Return Book</h2>

        <p class="text-muted">
            Return a borrowed book using ISBN, copy ID, or member information.
        </p>
    </div>


    <!-- Search Card -->
    <div class="card border rounded-4 mb-4">

        <div class="card-body p-3">

            <form asp-action="Index" method="post">

                <div class="row g-3 align-items-end">

                    <!-- Search By -->
                    <div class="col-md-5">

                        <label class="form-label fw-semibold small">
                            Search Borrowed Book By
                        </label>

                        <select name="searchBy"
                                class="form-select">

                            <option value="MemberCode"
                                    selected="@(ViewBag.SearchBy == "MemberId")">
                                Member ID / Phone
                            </option>

                            <option value="ISBN"
                                    selected="@(ViewBag.SearchBy == "ISBN")">
                                ISBN
                            </option>

                            <option value="CopyCode"
                                    selected="@(ViewBag.SearchBy == "CopyId")">
                                Copy ID
                            </option>

                        </select>

                    </div>


                    <!-- Search Text -->
                    <div class="col-md-5">

                        <label class="form-label fw-semibold small">
                            Search Text
                        </label>

                        <input type="text"
                               name="searchText"
                               class="form-control"
                               value="@ViewBag.SearchText"
                               placeholder="Enter search text..." />

                    </div>


                    <!-- Search Button -->
                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search me-1"></i>
                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Validation/Error -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(false)
        </div>
    }


    <!-- Results -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-3">

            @foreach (var item in Model)
            {
                <!-- Borrowed Book Information -->
                <div class="col-12">

                    <div class="card border rounded-4">

                        <div class="card-body p-3">

                            <div class="row g-4">

                                <!-- Book Information -->
                                <div class="col-md-6">

                                    <h5 class="fw-bold mb-4">
                                        Borrowed Book Information
                                    </h5>


                                    <div class="row mb-2">

                                        <div class="col-5 text-muted">
                                            Book
                                        </div>

                                        <div class="col-7 fw-semibold">
                                            @item.Title
                                        </div>

                                    </div>


                                    <div class="row mb-2">

                                        <div class="col-5 text-muted">
                                            Author
                                        </div>

                                        <div class="col-7 fw-semibold">
                                            @item.Author
                                        </div>

                                    </div>


                                    <div class="row mb-2">

                                        <div class="col-5 text-muted">
                                            ISBN
                                        </div>

                                        <div class="col-7 fw-semibold">
                                            @item.ISBN
                                        </div>

                                    </div>


                                    <div class="row mb-2">

                                        <div class="col-5 text-muted">
                                            Copy ID
                                        </div>

                                        <div class="col-7 fw-semibold">
                                            @item.CopyCode
                                        </div>

                                    </div>


                                    <div class="row">

                                        <div class="col-5 text-muted">
                                            Status
                                        </div>

                                        <div class="col-7">

                                            <span class="badge rounded-pill
                                                bg-warning text-dark
                                                px-3 py-2">

                                                @item.Status

                                            </span>

                                        </div>

                                    </div>

                                </div>


                                <!-- Borrower Information -->
                                <div class="col-md-6">

                                    <h5 class="fw-bold mb-4">
                                        Borrower Information
                                    </h5>


                                    <div class="row mb-2">

                                        <div class="col-5 text-muted">
                                            Name
                                        </div>

                                        <div class="col-7 fw-semibold">
                                            @item.Name
                                        </div>

                                    </div>


                                    <div class="row mb-2">

                                        <div class="col-5 text-muted">
                                            Member ID
                                        </div>

                                        <div class="col-7 fw-semibold">
                                            @item.MemberCode
                                        </div>

                                    </div>


                                    <div class="row mb-2">

                                        <div class="col-5 text-muted">
                                            Phone
                                        </div>

                                        <div class="col-7 fw-semibold">
                                            @item.Phone
                                        </div>

                                    </div>


                                    <div class="row mb-2">

                                        <div class="col-5 text-muted">
                                            Issue Date
                                        </div>

                                        <div class="col-7 fw-semibold">
                                            @item.IssueDate.ToString("dd MMM yyyy")
                                        </div>

                                    </div>


                                    <div class="row mb-3">

                                        <div class="col-5 text-muted">
                                            Due Date
                                        </div>

                                        <div class="col-7 fw-semibold">
                                            @item.DueDate.ToString("dd MMM yyyy")
                                        </div>

                                    </div>


                                    <!-- Return Button -->
                                    <form asp-action="ConfirmReturn"
                                          method="post">

                                        <input type="hidden"
                                               name="BorrowId"
                                               value="@item.BorrowId" />
                                        <button type="submit"
                                                class="btn btn-primary">

                                            <i class="bi bi-check-circle me-1"></i>
                                            Confirm Return

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else if (Model != null)
    {
        <div class="alert alert-info">
            No borrowed books found.
        </div>
    }

</div>