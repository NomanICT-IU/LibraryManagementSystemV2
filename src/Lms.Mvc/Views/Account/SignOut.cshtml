@{
    ViewData["Title"] = "Sign out";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">
        <h4 class="fw-bold mb-2">Sign out</h4>
        <p class="text-muted mb-4">
            Sign out of the Library Management System? Your session tokens will be cleared from this browser.
        </p>

        <form asp-action="SignOut" asp-controller="Account" method="post" class="d-flex flex-wrap gap-2">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Sign out</button>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
