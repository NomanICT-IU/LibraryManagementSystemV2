
@model ApiResponse<IEnumerable<BookDetailModel>>

@{
    ViewData["Title"] = "Search Book";
}

<div class="container-fluid">

    <div class="mb-4">
        <h4 class="fw-bold">Search Book</h4>
        <p class="text-muted small">Search by title, author name, or ISBN.</p>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">

                <div class="row g-3">
                    <div class="col-md-5">
                        <label for="searchBy" class="form-label small fw-semibold">Search By</label>
                        <select id="searchBy" name="searchBy" class="form-select">
                            <option value="">Search By</option>
                            <option value="Title" selected="@(ViewBag.SearchBy == "Title")">Title</option>
                            <option value="Author" selected="@(ViewBag.SearchBy == "Author")">Author</option>
                            <option value="ISBN" selected="@(ViewBag.SearchBy == "ISBN")">ISBN</option>
                        </select>
                    </div>

                    <div class="col-md-5">
                        <label for="searchText" class="form-label small fw-semibold">Search Text</label>
                        <input type="text" id="searchText" name="searchText"
                               value="@ViewBag.SearchText" class="form-control"
                               placeholder="Enter search text..." />
                    </div>

                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                        <a asp-action="Index" class="btn btn-secondary w-100">Clear</a>
                    </div>
                </div>

            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title fw-bold mb-4">Search Results</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Author</th>
                            <th>ISBN</th>
                            <th>Copy ID</th>
                            <th>Status</th>
                            <th>Borrower</th>
                            <th>Due Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Data?.Any() == true)
                        {
                            foreach (var book in Model.Data)
                            {
                                <tr>
                                    <td>@book.Title</td>
                                    <td>@book.Author</td>
                                    <td>@book.ISBN</td>
                                    <td>@book.CopyCode</td>
                                    <td>@book.Status</td>
                                    <td>@book.BorrowedBy</td>
                                    <td>@book.DueDate</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No books found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
```
