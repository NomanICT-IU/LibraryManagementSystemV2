@using Lms.Mvc.Models.ViewModels

@model BookCopyViewModel

@{
    ViewData["Title"] = "Create Book Copy";

}

<div class="container py-4">

    <!-- Create Book Copy -->
    <div class="row justify-content-center">

        <div class="col-12 col-lg-16">

            <div class="card border-0 shadow-sm rounded-4">

                <!-- Header -->
                <div class="card-header bg-primary text-white py-3 rounded-top-4">

                    <h4 class="mb-0">
                        <i class="bi bi-plus-circle me-2"></i>
                        Create Book Copy
                    </h4>

                </div>
                <!-- Form -->
                <div class="card-body p-4">
                    @(await Html.PartialAsync("_create", Model.BookCopy))
                </div>

            </div>

        </div>

    </div>

    <!-- Book Copy List -->
    <div class="card shadow-sm border-0">

        <!-- Card Body -->
        <div class="card-body p-0">

            @if (Model.BookCopies != null && Model.BookCopies.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Copy Code
                                </th>

                                <th>
                                    Book Title
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var copy in Model.BookCopies)
                            {
                                <tr>
                                    <!-- Copy Code -->
                                    <td>

                                        <span class="fw-semibold font-monospace">
                                            @copy.CopyCode
                                        </span>

                                    </td>


                                    <!-- Book Title -->
                                    <td>
                                        @copy.Title
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (copy.Status == 1)
                                        {
                                            <span class="badge bg-success">
                                                Available
                                            </span>
                                        }
                                        else if (copy.Status == 2)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Borrowed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Unknown
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end pe-4">

                                        <!-- View -->
                                        @* <a asp-action="Detail"
                                           asp-route-copyId="@copy.CopyId"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a> *@


                                        <!-- Edit -->
                                        <a asp-action="Index"
                                           asp-route-bookId="@copy.BookId"
                                           asp-route-copyId="@copy.CopyId"
                                     
                                           class="btn btn-sm btn-outline-warning">

                                            <i class="bi bi-pencil me-1"></i>
                                            Edit

                                        </a> 


                                        <!-- Delete -->
                                        <form asp-controller="BookCopy"
                                              asp-action="Delete"
                                              asp-route-copyId="@copy.CopyId"
                                              asp-route-bookId="@Model.BookCopy.BookId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this book copy?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash me-1"></i>
                                                Delete
                                            </button>

                                        </form>
                                       

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- No Records -->
                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-journal-x fs-1 text-muted"></i>

                    </div>

                    <h5 class="fw-semibold">
                        No book copies found
                    </h5>

                    <p class="text-muted mb-3">
                        There are currently no copies for this book.
                    </p>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

