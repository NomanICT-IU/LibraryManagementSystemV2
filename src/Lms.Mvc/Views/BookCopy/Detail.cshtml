@model BookCopyViewModel

@{
    ViewData["Title"] = "Book Copy Details";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="bg-primary text-white p-4">
                    <div class="d-flex align-items-center gap-3">

                        <div class="bg-white bg-opacity-25 rounded-3 p-3">
                            <i class="bi bi-book-half fs-2"></i>
                        </div>

                        <div>
                            <h2 class="mb-1 fw-bold">
                                @Model.Title
                            </h2>

                            <span class="text-white-50">
                                Book Copy Details
                            </span>
                        </div>

                    </div>
                </div>

                <!-- Book Copy Information -->
                <div class="card-body p-4 p-md-5">

                    <div class="row g-4">

                        <!-- Copy Code -->
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">

                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-upc-scan text-primary fs-5 me-2"></i>

                                    <span class="text-muted small fw-semibold">
                                        COPY CODE
                                    </span>
                                </div>

                                <div class="fw-semibold fs-5">
                                    @Model.CopyCode
                                </div>

                            </div>
                        </div>

                        <!-- Title -->
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">

                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-book text-primary fs-5 me-2"></i>

                                    <span class="text-muted small fw-semibold">
                                        BOOK TITLE
                                    </span>
                                </div>

                                <div class="fw-semibold fs-5">
                                    @Model.Title
                                </div>

                            </div>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">

                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-toggle-on text-primary fs-5 me-2"></i>

                                    <span class="text-muted small fw-semibold">
                                        STATUS
                                    </span>
                                </div>

                                <span class="badge @(Model.Status == 1 ? "bg-success" : "bg-secondary") fs-6 px-3 py-2">
                                    @(Model.Status == 1 ? "Available" : "Borrowed")
                                </span>

                            </div>
                        </div>

                    </div>

                </div>

                <!-- Actions -->
                <div class="card-footer bg-light border-0 p-4">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <!-- Back -->
                        <a asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i>
                            Back
                        </a>

                        <div class="d-flex flex-wrap gap-2">

                            <!-- Update -->
                            <a asp-action="Update"
                               asp-route-copyId="@Model.CopyId"
                               class="btn btn-primary">
                                <i class="bi bi-pencil-square me-1"></i>
                                Update Copy
                            </a>

                            <!-- Delete -->
                            <form asp-action="Delete"
                                  asp-route-copyId="@Model.CopyId"
                                  method="post"
                                  class="m-0"
                                  onsubmit="return confirm('Are you sure you want to delete this book copy?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger px-3">
                                    <i class="bi bi-trash me-1"></i>
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>