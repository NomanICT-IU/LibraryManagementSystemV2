@model ApiResponse<DashBoardModel>

@{
    ViewData["Title"] = "Dashboard";
}



<div class="container-fluid py-3">
    @if (!Model.IsError)
    {

    <!-- Statistics -->
    <div class="row g-3 mb-3">

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card dashboard-stat-card h-100">
                <div class="card-body">
                    <div class="stat-title">Total Books</div>
                    <div class="stat-value">@Model.Data.TotalBoks.ToString("N0")</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card dashboard-stat-card h-100">
                <div class="card-body">
                    <div class="stat-title">Available Copies</div>
                    <div class="stat-value">@Model.Data.AvailableCopies</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card dashboard-stat-card h-100">
                <div class="card-body">
                    <div class="stat-title">Borrowed Copies</div>
                    <div class="stat-value">@Model.Data.BorrowedCopies</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card dashboard-stat-card h-100">
                <div class="card-body">
                    <div class="stat-title">Members</div>
                    <div class="stat-value">@Model.Data.Member</div>
                </div>
            </div>
        </div>

    </div>


    <!-- Quick Actions -->
    <div class="row g-3 mb-3">

        <!-- Search Book -->
        <div class="col-12 col-md-4">
            <div class="card action-card h-100">
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title">
                        Search Book
                    </h5>

                    <p class="card-text">
                        Find books by title, author, or ISBN.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="Book"
                           asp-action="Search"
                           class="btn btn-primary">
                            Open
                        </a>
                    </div>

                </div>
            </div>
        </div>


        <!-- Issue Book -->
        <div class="col-12 col-md-4">
            <div class="card action-card h-100">
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title">
                        Issue Book
                    </h5>

                    <p class="card-text">
                        Issue an available copy to a member.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="Borrow"
                           asp-action="Issue"
                           class="btn btn-primary">
                            Open
                        </a>
                    </div>

                </div>
            </div>
        </div>


        <!-- Return Book -->
        <div class="col-12 col-md-4">
            <div class="card action-card h-100">
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title">
                        Return Book
                    </h5>

                    <p class="card-text">
                        Return a borrowed book copy.
                    </p>

                    <div class="mt-auto">
                        <a asp-controller="Borrow"
                           asp-action="Return"
                           class="btn btn-primary">
                            Open
                        </a>
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- Recent Borrowed Books -->
    <div class="card recent-card">

        <div class="card-body">

            <h5 class="section-title">
                Recent Borrowed Books
            </h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>BOOK TITLE</th>
                            <th>MEMBER</th>
                            <th>ISSUE DATE</th>
                            <th>DUE DATE</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Data.RecentBoardBooks.Any())
                        {
                            foreach (var book in Model.Data.RecentBoardBooks)
                            {
                                <tr>
                                    <td>
                                        @book.Title
                                    </td>

                                    <td>
                                        @book.Name
                                    </td>

                                    <td>
                                        @book.IssueDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @book.DueDate.ToString("dd MMM yyyy")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-4">
                                    No borrowed books found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    }
    else
    {
        <div
            class="text-center text-muted py-4">
            @Model.Message
        </div>
    }

</div>