<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Library Management System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lms.Mvc.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">LMS</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="Index">Home</a>
                        </li> *@
                        @* <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Book" asp-action="SearchBooks">Search Book</a>
                        </li> *@
                       @*  <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Book" asp-action="Create">Create Book</a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Book" asp-action="Index">Book List</a>
                        </li>
                        @* <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Book" asp-action="BookDetails">Book Details</a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Member" asp-action="Index">Member List</a>
                        @* </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Member" asp-action="MemberDetails">Member Details</a>
                        </li> *@
                        @* <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="BorrowedRecord" asp-action="Index">Return Book</a>
                        </li> *@
                       
                        @* <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Privacy" asp-action="Privacy">Privacy</a>
                        </li> *@

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container ">

        <main role="main" class="pb-3 d-flex">
            <!-- Sidebar -->
            @{
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
            }

            <div class="col-12 col-md-3 col-lg-2">

                <div class="text-white rounded-4 p-3 h-100"
                     style="background-color:#0f172a">

                    <h5 class="fw-bold mb-3 mb-md-4">
                        Library<br class="d-none d-md-block" />
                        Management
                    </h5>

                    <div class="nav flex-column gap-1 gap-md-2">

                        <!-- Dashboard -->
                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="nav-link text-white @(currentController == "Dashboard" && currentAction == "Index" ? "active bg-secondary rounded-3" : "")">
                            Dashboard
                        </a>

                        <!-- Search Book -->
                        <a asp-controller="Book"
                               asp-action="SearchBooks"
                               class="nav-link text-white @(currentController == "Book" && currentAction == "SearchBooks" ? "active bg-secondary rounded-3" : "")">
                            Search Book
                        </a>

                        <!-- Issue Book -->
                            <a asp-controller="BorrowedRecord"
                           asp-action="Issue"
                               class="nav-link text-white @(currentController == "BorrowedRecord" && currentAction == "Issue" ? "active bg-secondary rounded-3" : "")">
                            Issue Book
                        </a>

                        <!-- Return Book -->
                        <a asp-controller="BorrowedRecord"
                           asp-action="Index"
                               class="nav-link text-white @(currentController == "BorrowedRecord" && currentAction == "Index" ? "active bg-secondary rounded-3" : "")">
                            Return Book
                        </a>

                        <!-- Member Details -->
                        <a asp-controller="Member"
                           asp-action="MemberDetails"
                               class="nav-link text-white @(currentController == "Member" && currentAction == "MemberDetails" ? "active bg-secondary rounded-3" : "")"
                        @* style="font-size:0.8rem" *@
                        >
                            Member Details
                        </a>

                        <!-- Book Details -->
                        <a asp-controller="Book"
                           asp-action="BookDetails"
                           class="nav-link text-white @(currentController == "Book" && currentAction == "BookDetails" ? "active bg-secondary rounded-3" : "")">
                            Book Details
                        </a>

                    </div>

                </div>

            </div>
            <div class="col-12 col-md-9 col-lg-10">
                @RenderBody()
            </div>
          
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Lms.Mvc - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
